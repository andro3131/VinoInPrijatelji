<!-- Host modal -->
<div id="host-modal" class="fixed inset-0 z-[100] hidden">
  <div class="absolute inset-0 bg-teal-950/80 backdrop-blur-sm" id="host-modal-backdrop"></div>
  <div class="relative z-10 overflow-y-auto max-h-screen p-4 md:p-8" id="host-modal-overlay">
    <div class="bg-cream-50 rounded-3xl max-w-3xl w-full mx-auto shadow-2xl" id="host-modal-box">
      <button id="host-modal-close" class="absolute top-6 right-6 w-10 h-10 bg-teal-950/60 hover:bg-teal-950/80 text-white rounded-full flex items-center justify-center transition-colors z-20 cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
      <div id="host-modal-content"></div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ hosts }}>
  const hostData = hosts;

  function openHostModal(id) {
    const host = hostData.find(h => h.id === id);
    if (!host) return;

    const modal = document.getElementById('host-modal');
    const content = document.getElementById('host-modal-content');

    const allImages = host.image ? [host.image, ...host.gallery] : host.gallery;
    const positions = host.imagePositions || {};

    const heroHtml = host.image
      ? `<div class="relative mx-4 md:mx-6 rounded-2xl overflow-hidden" id="host-modal-hero">
           <img src="${host.image}" alt="${host.name}" class="w-full block object-cover transition-opacity duration-300" style="height: 50vh; object-position: center;" id="host-modal-hero-img" />
         </div>`
      : `<div class="relative mx-4 md:mx-6 rounded-2xl overflow-hidden bg-gradient-to-br from-teal-800 to-teal-900 flex items-center justify-center" style="height: 30vh;">
           <span class="font-heading text-7xl font-bold text-gold-400/40">${host.name.split(' ').map(n => n[0]).join('')}</span>
         </div>`;

    const galleryHtml = allImages.length > 1
      ? `<div class="grid grid-cols-4 gap-2 md:gap-3 mt-6">
          ${allImages.map((img, i) => `
            <img src="${img}" alt="${host.name} - slika ${i + 1}"
              class="rounded-xl w-full aspect-square object-cover hover:scale-[1.02] transition-transform cursor-pointer gallery-thumb ${i === 0 ? 'ring-2 ring-gold-500' : 'opacity-70 hover:opacity-100'}"
              data-full="${img}" data-position="${positions[img] || 'center'}" loading="lazy" />
          `).join('')}
        </div>`
      : '';

    content.innerHTML = `
      <div class="p-8 md:p-10 pb-4">
        <span class="bg-gold-500/90 text-teal-950 text-xs font-semibold px-3 py-1 rounded-full">${host.speciality}</span>
        <h3 class="text-2xl md:text-3xl font-heading font-bold text-teal-900 mt-4 mb-1">${host.name}</h3>
        <p class="text-gold-600 text-sm font-semibold uppercase tracking-wide mb-4">${host.location}</p>
        <p class="text-teal-800/70 leading-relaxed">${host.fullDescription}</p>
      </div>
      ${heroHtml}
      <div class="p-8 md:p-10 pt-4">${galleryHtml}</div>
    `;

    if (host.image && allImages.length > 1) {
      content.querySelectorAll('.gallery-thumb').forEach(thumb => {
        thumb.addEventListener('click', (e) => {
          e.stopPropagation();
          const heroImg = document.getElementById('host-modal-hero-img');
          heroImg.style.opacity = '0';
          setTimeout(() => {
            heroImg.src = thumb.dataset.full;
            heroImg.style.objectPosition = 'center ' + thumb.dataset.position;
            heroImg.style.opacity = '1';
          }, 150);
          content.querySelectorAll('.gallery-thumb').forEach(t => {
            t.classList.remove('ring-2', 'ring-gold-500');
            t.classList.add('opacity-70');
          });
          thumb.classList.add('ring-2', 'ring-gold-500');
          thumb.classList.remove('opacity-70');
        });
      });
    }

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeHostModal() {
    document.getElementById('host-modal').classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-host]').forEach(card => {
    card.addEventListener('click', () => openHostModal(card.dataset.host));
  });

  document.getElementById('host-modal-overlay')?.addEventListener('click', (e) => {
    if (!document.getElementById('host-modal-box')?.contains(e.target)) closeHostModal();
  });
  document.getElementById('host-modal-backdrop')?.addEventListener('click', closeHostModal);
  document.getElementById('host-modal-close')?.addEventListener('click', closeHostModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeHostModal(); });
</script>

