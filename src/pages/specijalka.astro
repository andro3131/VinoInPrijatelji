---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Sponsors from '../components/Sponsors.astro';
import Footer from '../components/Footer.astro';

const program = [
  {
    time: '16:30 – 17:00',
    title: 'Dobrodošlica',
    description: 'Prihod na posestvo Ravnikarjeve zidanice, prevzem kozarca, registracija in pozdravni kozarček.',
    icon: '🥂',
  },
  {
    time: '17:00 – 19:00',
    title: 'Vinska degustacija',
    description: 'Vodena vinska degustacija s sommelierjem in predstavitev 10 vzorcev vina obeh vinarjev, ob spremstvu prigrizkov.',
    icon: '🍷',
  },
  {
    time: '19:00 – 19:30',
    title: 'Sprostitev',
    description: 'Čas za sprostitev, živo muziko, druženje in kavico.',
    icon: '🎵',
  },
  {
    time: '19:30 – 00:00',
    title: 'Sunset after party',
    description: 'Sunset after party v spremljavi poletnih ritmov ter sončnega zahoda na razgledni ploščadi. DJ Urban Šilec (DJ Uxny).',
    icon: '🌅',
  },
];

const hosts = [
  {
    id: 'stih',
    name: 'Štihi Vinček',
    role: 'Gašper Štih',
    location: 'Smolenja vas pri Novem mestu',
    summary: 'Butična klet z iskrenim pristopom k vinarjenju. Gašper v svojih vinogradih išče ravnovesje med naravo in tradicijo dolenjskega terroir.',
    fullDescription: 'Mladi slovenski vinogradnik, član že pete generacije vinarjev v svojem vinogradu. Zidanica Štih leži v sončnem, gričatem delu Podgorja v vinski gorici Cerovci. Zidanica in vinograd ležita neposredno nad cerkvijo sv. Marije v Smolenji vasi v neposredni bližini dolenjske prestolnice. Gašper skupaj z očetom Igorjem obdeluje vinograd, skrbi pa tudi za »biznis« in marketing stran njunega vinskega udejstvovanja. Novost, ki sta jo z očetom predstavila v zadnjih letih je vedno večji hit na Dolenjskem področju – peneče vino. Štihi peninci boste lahko kot prva vzorca preizkusili tudi na samem dogodku.',
    speciality: 'Štihi Vinček',
    image: 'https://res.cloudinary.com/dewf3zos0/image/upload/v1779132092/2994DF28-CBAF-4323-A75E-FED9B3DA7C9A_pubebt.jpg',
    gallery: [
      'https://res.cloudinary.com/dewf3zos0/image/upload/v1779132092/IMG_5901_worjra.jpg',
      'https://res.cloudinary.com/dewf3zos0/image/upload/v1779132092/IMG_8515_yxcqcz.jpg',
    ],
    imagePositions: {},
  },
  {
    id: 'pangercen',
    name: 'Vinska klet Ravnikar',
    role: 'Urh Pangercen',
    location: 'Goljek pri Čatežu',
    summary: 'Na sončnem pobočju Dolenjske stoji Ravnikarjeva zidanica, obdana z vinogradi in tišino narave – dom Urhovega vinarjenja.',
    fullDescription: 'Ravnikarjeva zidanica se nahaja v Goljeku pri Čatežu, na sončnem pobočju Dolenjske, obdana z vinogradi in tišino narave. Urh Pangerc s predanostjo in ljubeznijo do zemlje prideluje vina, ki odražajo istovetnost tega kotička Dolenjske. V zidanici se prepletata tradicija, domačnost in ljubezen do vina, ki nastaja le nekaj korakov stran v kleti.',
    speciality: 'Ravnikarjeva zidanica',
    image: 'https://res.cloudinary.com/dewf3zos0/image/upload/v1771169167/IMG_0480_dun8aj.jpg',
    gallery: [
      'https://res.cloudinary.com/dewf3zos0/image/upload/v1771324076/IMG_3392_rpxnmk.jpg',
      'https://res.cloudinary.com/dewf3zos0/image/upload/v1771324074/IMG_3396_mhawom.jpg',
      'https://res.cloudinary.com/dewf3zos0/image/upload/v1771324072/IMG_3635_icgzut.jpg',
      'https://res.cloudinary.com/dewf3zos0/image/upload/v1779208257/700798090_1291393059291825_5172519253106409582_n_eozvof.jpg',
    ],
    imagePositions: {
      'https://res.cloudinary.com/dewf3zos0/image/upload/v1771169167/IMG_0480_dun8aj.jpg': '70%',
      'https://res.cloudinary.com/dewf3zos0/image/upload/v1771324076/IMG_3392_rpxnmk.jpg': '80%',
      'https://res.cloudinary.com/dewf3zos0/image/upload/v1771324074/IMG_3396_mhawom.jpg': '70%',
      'https://res.cloudinary.com/dewf3zos0/image/upload/v1771324072/IMG_3635_icgzut.jpg': '80%',
    },
  },
  {
    id: 'novak',
    name: 'Matevž Novak',
    role: 'Sommelier',
    location: '3. stopnja · šola Sommelie Master',
    summary: 'Certificirani sommelier 3. stopnje vas bo popeljal skozi svet vina, sommelierstva in ocenjevanja.',
    fullDescription: 'Matevž Novak je certificirani sommelier 3. stopnje šole Sommelie Master. Skozi večer bo udeležence popeljal skozi svet vina in sommelierstva. Degustacija bo obsegala 10 vzorcev vin – ob tem boste spoznali osnove ocenjevanja vina, pomembne značilnosti, tehnike degustacije ter zanimivosti iz vinskega sveta. Udeleženci bodo aktivno vključeni v proces degustacije in se za večer preizkusili v vlogi sommelierja.',
    speciality: 'Sommelier',
    image: 'https://res.cloudinary.com/dewf3zos0/image/upload/v1779132092/att.eLU-u1nhxFbm_rdhY3NmWWIu66v1rLkMGlYxF9K6fww_mzyqn7.jpg',
    gallery: [],
    imagePositions: {},
  },
];

const includes = [
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 3h9L14.5 9.5c-.4 1.5-1.5 2.5-2.5 2.5s-2.1-1-2.5-2.5L7.5 3zM12 12v7m-3.5.5h7" /></svg>`,
    title: '10 vzorcev vina',
    description: '5 vzorcev vsakega vinarja, s sommelierskim vodenjem skozi vsak vzorec.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4c0 1.1.9 2 2 2s2-.9 2-2V3M7 3v18" /><path stroke-linecap="round" stroke-linejoin="round" d="M17 3c-2 0-3 3-3 6s1 3 3 3M17 3v18" /></svg>`,
    title: 'Prigrizki',
    description: 'Spremljevalni prigrizki ob degustaciji vin.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0" /></svg>`,
    title: 'Sommelier vodstvo',
    description: 'Matevž Novak (3. stopnja) vas popelje skozi svet vina in sommelierstva.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m9 9 10.5-3m0 6.553v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66a2.25 2.25 0 0 0 1.632-2.163Zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 0 1-.99-3.467l2.31-.66A2.25 2.25 0 0 0 9 15.553Z" /></svg>`,
    title: 'Glasba z DJ-jem',
    description: 'Zabava s poletnimi ritmi z DJ Uxny-jem.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 0 1-1.5 1.5H4.5a1.5 1.5 0 0 1-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 1 0 9.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1 1 14.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" /></svg>`,
    title: 'Kozarček ob registraciji',
    description: 'Ob prihodu dobiš svoj kozarček za degustacije.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>`,
    title: 'Sunset after party',
    description: 'Zabava v noč. Vstop prost.',
  },
];
---

<Layout
  title="Od kleti do noči | Specijalka – Ravnikar x Štihi · 20. junij 2026"
  description="Posebna vinska degustacija s sommelierjem Matevžem Novakom in vinarjema Gašperjem Štihom ter Urh Pangercenom. 20. junij 2026, Ravnikarjeva zidanica, Goljek pri Čatežu."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </Fragment>
  <div class="specijalka-theme">
  <!-- Grain overlay -->
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-[998] opacity-[0.045]" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22250%22 height=%22250%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.75%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3CfeColorMatrix type=%22saturate%22 values=%220%22/%3E%3C/filter%3E%3Crect width=%22250%22 height=%22250%22 filter=%22url(%23n)%22/%3E%3C/svg%3E'); background-size: 250px 250px;"></div>
  <Navbar />
  <main>

    <!-- HERO -->
    <section class="relative h-screen flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-b from-teal-950/75 via-teal-950/30 to-teal-950/85 z-10"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#8B1A2A]/35 via-transparent to-transparent z-10"></div>
        <img
          src="https://res.cloudinary.com/dewf3zos0/image/upload/v1779207089/701495333_1768545937888381_5472487333592191135_n_a8srbs.jpg"
          alt="Ravnikarjeva zidanica, Goljek pri Čatežu"
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="relative z-20 text-center px-6 max-w-4xl mx-auto">
        <p class="text-gold-400 text-sm md:text-base tracking-[0.35em] uppercase mb-6 font-medium hero-date">
          Od kleti do noči &middot; 20. junij 2026 &middot; Goljek pri Čatežu
        </p>

        <h1 class="text-7xl md:text-9xl lg:text-[11rem] font-heading font-bold text-white mb-5 leading-none tracking-tight hero-float">
          Specijalka
        </h1>

        <p class="text-2xl md:text-3xl text-white/85 font-heading italic mb-4">
          Ravnikar x Štihi Vinček
        </p>

        <p class="text-xs md:text-sm text-white/45 tracking-[0.3em] uppercase mb-10">
          Sommelier Matevž Novak
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#vstopnice"
            class="bg-gold-500 hover:bg-gold-400 text-teal-950 px-8 py-4 rounded-full text-base font-semibold tracking-wide transition-all hover:scale-105"
          >
            Rezerviraj svoje mesto
          </a>
          <a
            href="#o-dogodku"
            class="border border-white/30 hover:border-white/60 text-white px-8 py-4 rounded-full text-base font-medium tracking-wide transition-all hover:bg-white/10"
          >
            Več o dogodku
          </a>
        </div>
      </div>

      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20">
        <div class="w-6 h-10 border-2 border-white/30 rounded-full flex justify-center pt-2">
          <div class="w-1 h-3 bg-gold-500 rounded-full animate-bounce"></div>
        </div>
      </div>
    </section>

    <!-- O DOGODKU -->
    <section id="o-dogodku" class="py-24 md:py-32 bg-cream-50">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <div class="fade-in">
          <div class="flex items-center justify-center gap-4 mb-8">
            <div class="w-12 h-px bg-gold-500"></div>
            <svg class="w-6 h-6 text-gold-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.5 2 5 5.5 5 10c0 2.5 1.5 5 3 7h8c1.5-2 3-4.5 3-7 0-4.5-3.5-8-7-8zm-1 18h2v2h-2v-2z" opacity="0.7"/>
            </svg>
            <div class="w-12 h-px bg-gold-500"></div>
          </div>

          <p class="text-gold-600 text-sm tracking-[0.3em] uppercase mb-4 font-medium">Specijalka – Ravnikar x Štihi</p>

          <h2 class="text-3xl md:text-5xl font-heading font-bold text-teal-900 mb-8">
            O dogodku
          </h2>

          <p class="text-lg md:text-xl text-teal-800/80 leading-relaxed mb-6 max-w-3xl mx-auto text-justify">
            Posebna vinska degustacija v organizaciji Ravnikarjeve zidanice in Štihi vinčka, pripravljena v sklopu zgodbe &raquo;Od kleti do noči&laquo;. Dogodek v lokalnem dolenjskem okolju, namenjen vsem ljubiteljem vina, druženja in dobre glasbe.
          </p>

          <p class="text-lg md:text-xl text-teal-800/80 leading-relaxed mb-6 max-w-3xl mx-auto text-justify">
            Dogodek vključuje posebno vinsko degustacijo v sodelovanju z mladima vinogradnikoma: <strong class="text-teal-900">Urhom Pangercem</strong> (Ravnikarjeva zidanica, Goljek pri Čatežu) in <strong class="text-teal-900">Gašperjem Štihom</strong> (Štihi Vinček, Smolenja vas pri Novem mestu). Skozi večer bosta predstavila svojo zgodbo ter izbor svojih najboljših vin.
          </p>

          <p class="text-lg md:text-xl text-teal-800/80 leading-relaxed mb-6 max-w-3xl mx-auto text-justify">
            Vodeno degustacijo bo vodil sommelier <strong class="text-teal-900">Matevž Novak</strong> (3. stopnja, šole Sommelie Master), ki bo udeležence popeljal skozi svet vina in sommelierstva. Degustacija bo obsegala <strong class="text-teal-900">10 vzorcev vin</strong>, ob tem pa boste spoznali osnove ocenjevanja vina, pomembne značilnosti, tehnike degustacije ter zanimivosti iz vinskega sveta.
          </p>

          <p class="text-lg md:text-xl text-teal-800/80 leading-relaxed mb-6 max-w-3xl mx-auto text-justify">
            Dogodek ima tudi izobraževalno noto, udeleženci boste namreč aktivno vključeni v proces degustacije in se za večer preizkusili v vlogi sommelierja. Vinarja bosta skupaj z sommelierjem dodatno predstavila posebnosti pridelave vina v njunih vinogradih ter komentirala posamezne vzorce. Za spremljavo bodo na voljo tudi prigrizki.
          </p>

          <p class="text-lg md:text-xl text-teal-800/80 leading-relaxed mb-6 max-w-3xl mx-auto text-justify">
            Po zaključku uradnega dela sledi sproščen večerni program: živa glasba ter sunset after party z DJ-jem Urbanom Šilcem (DJ Uxny).
          </p>

          <p class="text-lg md:text-xl text-teal-800/70 leading-relaxed max-w-3xl mx-auto text-justify">
            Cena vinske degustacije znaša <strong class="text-teal-900">35 €</strong>. Vstop na after party je prost, na prizorišču afterja pa je plačilo možno izključno z gotovino.
          </p>
        </div>

        <div class="fade-in grid grid-cols-2 md:grid-cols-4 gap-8 mt-16 pt-16 border-t border-teal-800/10">
          <div>
            <p class="text-3xl md:text-4xl font-heading font-bold text-gold-500">2</p>
            <p class="text-sm text-teal-800/60 mt-1 uppercase tracking-wide">Vinarji</p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl font-heading font-bold text-gold-500">10</p>
            <p class="text-sm text-teal-800/60 mt-1 uppercase tracking-wide">Vzorcev vina</p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl font-heading font-bold text-gold-500">1</p>
            <p class="text-sm text-teal-800/60 mt-1 uppercase tracking-wide">Sommelier</p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl font-heading font-bold text-gold-500">&infin;</p>
            <p class="text-sm text-teal-800/60 mt-1 uppercase tracking-wide">Spominov</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROGRAM -->
    <section id="program" class="py-24 md:py-32 bg-teal-900 s-diag">
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-16 fade-in">
          <div class="flex items-center justify-center gap-4 mb-8">
            <div class="w-12 h-px bg-gold-500/50"></div>
            <p class="text-gold-400 text-sm tracking-[0.3em] uppercase">Potek večera</p>
            <div class="w-12 h-px bg-gold-500/50"></div>
          </div>
          <h2 class="text-3xl md:text-5xl font-heading font-bold text-white">
            Program
          </h2>
        </div>

        <div class="relative">
          <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-px bg-gold-500/20 md:-translate-x-px"></div>

          {program.map((event, i) => (
            <div class={`fade-in relative flex items-start gap-6 md:gap-0 mb-12 last:mb-0 ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
              <div class={`flex-1 md:w-1/2 ${i % 2 === 0 ? 'md:pr-12 md:text-right' : 'md:pl-12 md:text-left'} ml-16 md:ml-0`}>
                <p class="text-gold-400 font-heading text-lg font-semibold">{event.time}</p>
                <h3 class="text-xl font-heading font-bold text-white mt-1">{event.title}</h3>
                <p class="text-white/60 mt-2 text-sm leading-relaxed">{event.description}</p>
              </div>

              <div class="absolute left-4 md:left-1/2 md:-translate-x-1/2 w-8 h-8 bg-teal-800 border-2 border-gold-500/40 rounded-full flex items-center justify-center text-sm z-10">
                {event.icon}
              </div>

              <div class="hidden md:block flex-1 md:w-1/2"></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- KAJ JE VKLJUČENO -->
    <section class="py-24 md:py-32 bg-cream-100">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16 fade-in">
          <div class="flex items-center justify-center gap-4 mb-8">
            <div class="w-12 h-px bg-gold-500"></div>
            <p class="text-gold-600 text-sm tracking-[0.3em] uppercase">Vse v eni ceni</p>
            <div class="w-12 h-px bg-gold-500"></div>
          </div>
          <h2 class="text-3xl md:text-5xl font-heading font-bold text-teal-900">
            Kaj je vključeno
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {includes.map((item, i) => (
            <div class="fade-in">
              <div
                class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-all hover:-translate-y-1 border border-teal-800/5 card-float h-full"
                style={`animation-duration: ${3 + (i % 3) * 0.8}s; animation-delay: ${i * 0.4}s;`}
              >
                <div class="text-gold-500 mb-4 group-hover:scale-110 transition-transform" set:html={item.icon} />
                <h3 class="text-lg font-heading font-bold text-teal-900 mb-2">{item.title}</h3>
                <p class="text-teal-800/60 text-sm leading-relaxed">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- GOSTITELJI -->
    <section id="vinarji" class="py-24 md:py-32 bg-cream-50">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16 fade-in">
          <div class="flex items-center justify-center gap-4 mb-8">
